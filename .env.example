# ZeroHub settings. The server creates .env and a random PIN on first launch.
# To choose your own first password, set HUB_INITIAL_PIN in the process environment.
HUB_HOST=0.0.0.0
HUB_PORT=8765
HUB_HTTPS_PORT=8766
HUB_PIN=
HUB_PROXY=auto
HUB_VOICE_MODEL=small
HUB_VOICE_DEVICE=cpu

# Relative to the installation folder.
HUB_DATA_DIR=./data
USERS_DIR=./users
PROJECTS_ROOT=./users/admin/projects
SHARED_PROJECTS_DIR=./shared_projects

# Public updates require no credentials. Only release authors set a token locally.
GITHUB_REPO_OWNER=atomexpert
GITHUB_REPO_NAME=ZeroHub
GITHUB_PUBLISH_TOKEN=
